  "technical_details": {
    "ocr_engines": {
      "PaddleOCR": {
        "advantages": [
          "Optimizado para números",
          "Muy preciso en textos pequeños",
          "Soporte para detección de ángulo",
          "Mejor para imágenes de baja calidad"
        ],
        "configuration": {
          "use_angle_cls": true,
          "lang": "en",
          "enable_mkldnn": false
        }
      },
      "EasyOCR": {
        "advantages": [
          "Fallback confiable",
          "Mejor manejo de variaciones",
          "Compatible con múltiples idiomas",
          "Detección más rápida que Tesseract"
        ],
        "configuration": {
          "languages": ["en"],
          "gpu": false
        }
      },
      "Tesseract": {
        "advantages": [
          "Fallback final altamente confiable",
          "Configuración específica para números",
          "PSM 6 (bloques de texto uniforme)"
        ],
        "configuration": {
          "psm": 6,
          "whitelist": "0123456789"
        }
      }
    },
    "preprocessing_pipeline": {
      "step_1": {
        "name": "Detección de ángulo",
        "method": "Hough Lines",
        "purpose": "Corregir rotación de camiseta",
        "tolerance": "±2 grados"
      },
      "step_2": {
        "name": "Artifact Removal",
        "method": "Morphological Operations",
        "purpose": "Remover logos y símbolos",
        "threshold": "100 píxeles de área"
      },
      "step_3": {
        "name": "CLAHE Enhancement",
        "method": "Contrast Limited Adaptive Histogram Equalization",
        "clipLimit": 2.0,
        "tileGridSize": [8, 8],
        "purpose": "Mejorar contraste"
      },
      "step_4": {
        "name": "Denoise",
        "method": "fastNlMeansDenoising",
        "purpose": "Remover ruido preservando bordes"
      },
      "step_5": {
        "name": "Binarization",
        "method": "Otsu vs Adaptive (automático)",
        "purpose": "Crear imagen binaria óptima",
        "selection": "Por varianza de Laplacian"
      },
      "step_6": {
        "name": "Scaling",
        "factor": 3,
        "method": "INTER_CUBIC",
        "purpose": "Aumentar resolución para OCR"
      }
    },
    "validation_rules": {
      "number_range": {
        "min": 0,
        "max": 99,
        "reason": "Números de camiseta válidos en fútbol"
      },
      "confidence_threshold": {
        "value": 0.7,
        "description": "Rechazar detecciones con confianza < 70%",
        "configurable": true
      },
      "duplicate_detection": {
        "suspicious_patterns": ["11", "22", "33", "44", "55", "66", "77", "88", "99"],
        "low_confidence_flag": 0.75,
        "confusing_digits": {
          "1": ["6", "9", "8"],
          "6": ["9", "8"],
          "9": ["6"],
          "8": ["0"],
          "0": ["8"]
        }
      }
    },
    "cache_system": {
      "type": "LRU Cache with Hash",
      "max_size": 500,
      "hash_method": "MD5 de región",
      "hit_rate_tracking": true,
      "benefits": [
        "Evita re-procesamiento de mismas regiones",
        "Acelera detección en videos (frames repetidos)",
        "Reduce carga de OCR"
      ]
    },
    "parallelization": {
      "method": "ThreadPoolExecutor",
      "max_workers": 4,
      "granularity": "Por jugador",
      "benefits": [
        "Procesa múltiples jugadores simultáneamente",
        "Escalable según cantidad de cores",
        "Manejo automático de errores en threads"
      ]
    }
  },
