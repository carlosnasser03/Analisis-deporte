  "installation_instructions": {
    "production_quick": "pip install -r requirements.txt",
    "production_verbose": "pip install -r requirements.txt --verbose",
    "development": "pip install -r requirements-dev.txt",
    "setup_script": "python 1_preparar.py (includes model download and OpenVINO export)",
    "sports_manual": "pip install ./sports-main (after extracting from GitHub)"
  },

  "known_issues": {
    "issue_1": {
      "package": "paddleocr",
      "issue": "Large download on first use (~200MB for OCR models)",
      "workaround": "Pre-download models or use easyocr as fallback"
    },

    "issue_2": {
      "package": "reportlab",
      "issue": "May need additional fonts on some systems",
      "workaround": "Use system fonts or install reportlab[fonts]"
    },

    "issue_3": {
      "package": "openvino",
      "issue": "Optional dependency, not all features require it",
      "workaround": "Install separately if CPU optimization needed"
    },

    "issue_4": {
      "package": "easyocr",
      "issue": "Requires different model than paddleocr",
      "workaround": "Used as fallback only if paddleocr unavailable"
    }
  },

