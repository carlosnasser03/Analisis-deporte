    "storage": {
      "models": "~500MB (3 YOLO models)",
      "ocr_models": "~200MB (OCR models, downloaded on first use)",
      "python_packages": "~2-3GB (all dependencies including ML packages)"
    },

    "processor": {
      "minimum": "Any modern processor",
      "recommended": "Intel processor for OpenVINO optimization"
    }
  },

  "version_pinning_strategy": {
    "rationale": "Use semantic versioning ranges (^x.y.z) to allow patch/minor updates while preventing breaking changes",

