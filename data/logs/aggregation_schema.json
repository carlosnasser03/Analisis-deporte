{
  "title": "Player Statistics Aggregation Schema",
  "version": "1.0",
  "description": "JSON Schema for unified player statistics after aggregation",
  "definitions": {
    "PlayerStats": {
      "type": "object",
      "title": "Aggregated Player Statistics",
      "required": [
        "player_id",
        "player_number",
        "team_id",
        "player_name",
        "position",
        "distance_total_m",
        "distance_total_km",
        "velocity_max",
        "velocity_avg",
        "velocity_median",
        "intensity_pct",
        "timestamp",
        "format_version"
      ],
      "properties": {
        "player_id": {
          "type": "integer",
          "description": "Unique player identifier",
          "minimum": 1
        },
        "player_number": {
          "type": "integer",
          "description": "Jersey number",
          "minimum": 1,
          "maximum": 99
        },
        "team_id": {
          "type": "string",
          "description": "Team identifier (e.g., 'A', 'B', 'HomeTeam')",
          "minLength": 1
        },
        "player_name": {
          "type": "string",
          "description": "Player's full name"
        },
        "position": {
          "type": "string",
          "description": "Playing position",
          "enum": ["GK", "DEF", "MID", "FWD"]
        },
        "distance_total_m": {
          "type": "number",
          "description": "Total distance covered in meters",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "distance_total_km": {
          "type": "number",
          "description": "Total distance covered in kilometers",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "velocity_max": {
          "type": "number",
          "description": "Maximum velocity in m/s",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "velocity_avg": {
          "type": "number",
          "description": "Average velocity in m/s",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "velocity_median": {
          "type": "number",
          "description": "Median velocity in m/s",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "velocity_percentile_90": {
          "type": "number",
          "description": "90th percentile velocity in m/s",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "velocity_percentile_95": {
          "type": "number",
          "description": "95th percentile velocity in m/s",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "velocity_std": {
          "type": "number",
          "description": "Standard deviation of velocity",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "intensity_pct": {
          "type": "number",
          "description": "Percentage of time in motion (intensity)",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "high_intensity_distance": {
          "type": "number",
          "description": "Distance covered at high intensity (>=6 m/s) in meters",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "sprints_count": {
          "type": "integer",
          "description": "Total number of sprints detected",
          "minimum": 0
        },
        "directional_changes": {
          "type": "integer",
          "description": "Total number of directional changes",
          "minimum": 0
        },
        "zones_visited": {
          "type": "array",
          "description": "List of zones visited by the player",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "dominant_zone": {
          "type": "string",
          "description": "Zone where player spent most time"
        },
        "zone_concentration_pct": {
          "type": "number",
          "description": "Percentage of time in dominant zone",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "movement_profile": {
          "type": "string",
          "description": "Movement profile classification",
          "enum": ["static", "low_intensity", "balanced", "high_intensity", "explosive"]
        },
        "heatmap_path": {
          "type": ["string", "null"],
          "description": "Path to heatmap PNG image file",
          "pattern": "^(/|\\\\)?[a-zA-Z0-9/_\\\\-\\.]+\\.png$"
        },
        "distance_percentile": {
          "type": "number",
          "description": "Player's distance percentile vs team",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "velocity_percentile": {
          "type": "number",
          "description": "Player's velocity percentile vs team",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "intensity_percentile": {
          "type": "number",
          "description": "Player's intensity percentile vs team",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.1
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of aggregation",
          "format": "date-time"
        },
        "format_version": {
          "type": "string",
          "description": "Schema version",
          "pattern": "^\\d+\\.\\d+$"
        },
        "analysis_frames": {
          "type": "integer",
          "description": "Number of frames analyzed",
          "minimum": 0
        },
        "intensity_breakdown": {
          "type": "object",
          "description": "Breakdown of time by intensity category",
          "properties": {
            "static": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "walking": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "jogging": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "running": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sprinting": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "zone_stats": {
          "type": "array",
          "description": "Detailed statistics per zone",
          "items": {
            "type": "object",
            "properties": {
              "zone_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "zone_name": {
                "type": "string"
              },
              "time_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "distance_m": {
                "type": "number",
                "minimum": 0
              },
              "avg_velocity_m_s": {
                "type": "number",
                "minimum": 0
              },
              "max_velocity_m_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "speed_categories": {
          "type": "object",
          "description": "Speed metrics by category",
          "properties": {
            "max_m_s": {
              "type": "number",
              "minimum": 0
            },
            "avg_m_s": {
              "type": "number",
              "minimum": 0
            },
            "median_m_s": {
              "type": "number",
              "minimum": 0
            },
            "p90_m_s": {
              "type": "number",
              "minimum": 0
            },
            "p95_m_s": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "comparison_vs_team": {
          "type": "object",
          "description": "Player's metrics compared to team",
          "properties": {
            "distance_percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "velocity_percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "intensity_percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "distance_vs_avg": {
              "type": "number",
              "description": "Difference from team average distance in meters"
            },
            "velocity_vs_avg": {
              "type": "number",
              "description": "Difference from team average velocity in m/s"
            },
            "intensity_vs_avg": {
              "type": "number",
              "description": "Difference from team average intensity in %"
            }
          }
        }
      }
    },
    "TeamSummary": {
      "type": "object",
      "title": "Team Summary Statistics",
      "properties": {
        "team_id": {
          "type": "string"
        },
        "players_count": {
          "type": "integer",
          "minimum": 1
        },
        "distance_avg_m": {
          "type": "number",
          "minimum": 0
        },
        "distance_max_m": {
          "type": "number",
          "minimum": 0
        },
        "distance_min_m": {
          "type": "number",
          "minimum": 0
        },
        "distance_avg_km": {
          "type": "number",
          "minimum": 0
        },
        "velocity_avg_m_s": {
          "type": "number",
          "minimum": 0
        },
        "velocity_max_m_s": {
          "type": "number",
          "minimum": 0
        },
        "velocity_min_m_s": {
          "type": "number",
          "minimum": 0
        },
        "intensity_avg_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "intensity_max_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "intensity_min_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sprints_total": {
          "type": "integer",
          "minimum": 0
        },
        "sprints_avg": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ComparisonExport": {
      "type": "object",
      "title": "Comparison Export Format",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "team_summary": {
          "$ref": "#/definitions/TeamSummary"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "player_id": {
                "type": "integer"
              },
              "player_number": {
                "type": "integer"
              },
              "player_name": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "metrics": {
                "type": "object",
                "properties": {
                  "distance": {
                    "type": "object",
                    "properties": {
                      "value_m": {
                        "type": "number"
                      },
                      "percentile": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "vs_team_avg": {
                        "type": "number"
                      }
                    }
                  },
                  "velocity": {
                    "type": "object",
                    "properties": {
                      "value_m_s": {
                        "type": "number"
                      },
                      "percentile": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "vs_team_avg": {
                        "type": "number"
                      }
                    }
                  },
                  "intensity": {
                    "type": "object",
                    "properties": {
                      "value_pct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "percentile": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "vs_team_avg": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ExecutiveSummary": {
      "type": "object",
      "title": "Executive Summary Format",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "format_version": {
          "type": "string"
        },
        "team_summary": {
          "$ref": "#/definitions/TeamSummary"
        },
        "movement_profiles": {
          "type": "object",
          "description": "Count of players by movement profile",
          "properties": {
            "static": {
              "type": "integer"
            },
            "low_intensity": {
              "type": "integer"
            },
            "balanced": {
              "type": "integer"
            },
            "high_intensity": {
              "type": "integer"
            },
            "explosive": {
              "type": "integer"
            }
          }
        },
        "top_performers": {
          "type": "object",
          "properties": {
            "distance": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object"
              }
            },
            "intensity": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object"
              }
            },
            "velocity": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object"
              }
            }
          }
        },
        "statistics": {
          "type": "object",
          "properties": {
            "total_players_analyzed": {
              "type": "integer"
            },
            "average_distance_km": {
              "type": "number"
            },
            "total_team_distance_km": {
              "type": "number"
            },
            "average_intensity_pct": {
              "type": "number"
            },
            "total_sprints": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "documentation": {
    "overview": "Schema for player statistics aggregation module (FASE 4 - TAREA 4)",
    "purpose": "Unified statistics consolidation from multiple metric sources",
    "formats": {
      "player_json": "Individual player statistics in JSON format (player_{number}.json)",
      "csv": "Consolidated player statistics in CSV format (jugadores.csv)",
      "comparison": "Comparative metrics vs team (comparativa.json)",
      "summary": "Executive summary (resumen_ejecutivo.json)"
    },
    "validation_rules": {
      "distance": "Must be non-negative; km auto-calculated from meters",
      "velocity": "Must be non-negative; median should be <= average",
      "intensity": "Must be 0-100%; sum of categories should equal ~100%",
      "percentile": "Must be 0-100%",
      "timestamp": "Must be ISO 8601 format",
      "position": "Must be one of: GK, DEF, MID, FWD"
    },
    "notes": [
      "All distance metrics in meters by default, km auto-calculated",
      "All velocity metrics in m/s",
      "All intensity metrics as percentage (0-100)",
      "Timestamps are always UTC in ISO 8601 format",
      "Missing data is imputed with sensible defaults",
      "Percentiles calculated from team averages",
      "Movement profiles determined from combined metrics"
    ]
  }
}
